<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.QuickAccessDockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:QuickAccessDockViewModel}"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <controls:SettingsPageControl
        x:Uid="QuickAccessDock"
        IsTabStop="False"
        ModuleImageSource="ms-appx:///Assets/Settings/Modules/QuickAccessDock.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">
                <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Uid="QuickAccessDock_EnableSettingsCard"
                        HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/QuickAccessDock.png}"
                        IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:GPOInfoControl>

                <controls:SettingsGroup x:Uid="QuickAccessDock_AppearanceGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Uid="QuickAccessDock_ThemeSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="QuickAccessDock_Theme_System" />
                            <ComboBoxItem x:Uid="QuickAccessDock_Theme_Light" />
                            <ComboBoxItem x:Uid="QuickAccessDock_Theme_Dark" />
                        </ComboBox>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Uid="QuickAccessDock_StyleSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE771;}">
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind ViewModel.Style, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="QuickAccessDock_Style_Default" />
                            <ComboBoxItem x:Uid="QuickAccessDock_Style_Neomorphism" />
                            <ComboBoxItem x:Uid="QuickAccessDock_Style_Acrylic" />
                        </ComboBox>
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Uid="QuickAccessDock_BehaviorGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsExpander
                        x:Uid="QuickAccessDock_AutoHideSettingsExpander"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7C4;}"
                        IsExpanded="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoHide, Mode=TwoWay}" />
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="QuickAccessDock_AutoHideDelaySettingsCard"
                                IsEnabled="{x:Bind ViewModel.AutoHide, Mode=OneWay}">
                                <NumberBox
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    LargeChange="500"
                                    Maximum="10000"
                                    Minimum="200"
                                    SmallChange="100"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.AutoHideDelayMs, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <tkcontrols:SettingsCard
                        x:Uid="QuickAccessDock_SnapThresholdSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                        <NumberBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            LargeChange="8"
                            Maximum="160"
                            Minimum="4"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.SnapThreshold, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Uid="QuickAccessDock_SyncWebsiteIconsSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.SyncWebsiteIcons, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>

        <controls:SettingsPageControl.PrimaryLinks>
            <controls:PageLink x:Uid="LearnMore_QuickAccessDock" Link="https://aka.ms/PowerToysOverview" />
        </controls:SettingsPageControl.PrimaryLinks>
    </controls:SettingsPageControl>
</local:NavigablePage>
