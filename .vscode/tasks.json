{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "cmd.exe",
        "args": ["/d", "/c"]
      }
    }
  },

  "inputs": [
    {
      "id": "config",
      "type": "pickString",
      "description": "Configuration",
      "options": ["Debug", "Release"],
      "default": "Debug"
    },
    {
      "id": "platform",
      "type": "pickString",
      "description": "Platform (leave empty to auto-detect host platform)",
      "options": ["", "X64", "ARM64"],
      "default": "X64"
    },
    {
      "id": "msbuildExtra",
      "type": "promptString",
      "description": "Extra MSBuild args (optional). Example: /p:CIBuild=true /m",
      "default": ""
    }
  ],

  "tasks": [
    {
      "label": "PT: Build (quick)",
      "type": "shell",
      "command": "\"${workspaceFolder}\\tools\\build\\build.cmd\"",
      "args": [
        "-Path",
        "${fileDirname}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "PT: Build (with options)",
      "type": "shell",
      "command": "\"${workspaceFolder}\\tools\\build\\build.cmd\"",
      "args": [
        "-Path",
        "${fileDirname}",
        "-Platform",
        "${input:platform}",
        "-Configuration",
        "${input:config}",
        "${input:msbuildExtra}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "PT: Build FloatingDock (dock helper)",
      "detail": "Stops any running dock, then builds PowerToys.FloatingDock.exe (fast inner loop).",
      "type": "shell",
      "command": "taskkill /IM PowerToys.FloatingDock.exe /F >nul 2>&1 & dotnet build \"${workspaceFolder}\\src\\modules\\FloatingDock\\FloatingDock\\FloatingDock.csproj\" -c Debug -p:Platform=x64 -v m --nologo",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "PT: Build Settings (PowerToys Settings UI)",
      "detail": "Stops any running Settings app, then builds PowerToys.Settings.exe and its dependencies (needs 'PT: Build Essentials' once first to restore packages).",
      "type": "shell",
      "command": "taskkill /IM PowerToys.Settings.exe /F >nul 2>&1 & \"${workspaceFolder}\\tools\\build\\build.cmd\" -Path \"${workspaceFolder}\\src\\settings-ui\\Settings.UI\" -Platform x64 -Configuration Debug",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "PT: Build FloatingDock + Settings",
      "detail": "One-click build for the dock helper and the PowerToys Settings UI (in sequence).",
      "dependsOrder": "sequence",
      "dependsOn": [
        "PT: Build FloatingDock (dock helper)",
        "PT: Build Settings (PowerToys Settings UI)"
      ],
      "group": "build",
      "problemMatcher": []
    },

    {
      "label": "PT: Build Essentials (quick)",
      "type": "shell",
      "command": "\"${workspaceFolder}\\tools\\build\\build-essentials.cmd\"",
      "args": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    {
      "label": "PT: Build Essentials (with options)",
      "type": "shell",
      "command": "\"${workspaceFolder}\\tools\\build\\build-essentials.cmd\"",
      "args": [
        "-Platform",
        "${input:platform}",
        "-Configuration",
        "${input:config}",
        "${input:msbuildExtra}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
